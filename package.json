{
  "name": "react-bkoi-gl",
  "version": "2.0.0",
  "engines": {
    "node": "^22.4.1"
  },
  "description": "React components for Barikoi GL JS",
  "type": "module",
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "author": "barikoi",
  "readme": "README.md",
  "license": "MIT",
  "homepage": "https://docs.barikoi.com/docs/maps-api",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    },
    "./styles": {
      "import": "./dist/styles/react-bkoi-gl.css",
      "default": "./dist/styles/react-bkoi-gl.css"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json",
    "build": "ocular-clean && ocular-build && node scripts/modify-css.js",
    "lint": "ocular-lint",
    "cover": "ocular-test cover",
    "test": "npm run typecheck && ocular-test",
    "test-fast": "npm run typecheck && ocular-test node",
    "metrics": "ocular-metrics",
    "coverage": "jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "^23.2.1",
    "bkoi-gl": ">=2.0.0",
    "maplibre-gl": "^5.4.0"
  },
  "peerDependencies": {
    "react": ">=16.3.0",
    "react-dom": ">=16.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-modules-commonjs": "^7.23.3",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@babel/runtime": "^7.24.0",
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^16.0.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-add-import-extension": "^1.6.0",
    "bkoi-gl": ">=2.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ocular-dev-tools": "^2.0.0-alpha.31",
    "puppeteer": "^22.4.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tape-promise": "^4.0.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "barikoi",
    "bkoi-gl",
    "react",
    "react-bkoi-gl",
    "react bkoi"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/barikoi/react-bkoi-gl.git"
  }
}
