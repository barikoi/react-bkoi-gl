{
  "compilerOptions": {
    "target": "es2020",
    "module": "es2020",
    "jsx": "react",
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "sourceMap": true,
    "outDir": "./dist",

    /* Rules added to bypass the strict type errors from your logs */
    "strictNullChecks": false,
    "noImplicitAny": false,

    /* Explicitly tell TS to load GeoJSON globally */
    "types": ["geojson"],

    /* Add this line to bypass the DTS build crash */
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*",
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "coverage",
    "public"
  ]
}